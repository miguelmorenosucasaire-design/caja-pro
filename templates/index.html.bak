            <!-- 3. SECCIÓN: PLANTILLA DE ESTUDIANTES (DEBEN Y FALTAN COMPLETAR)   -->
            <!-- =================================================================== -->
            <div id="section-estudiantes" class="hidden space-y-6">
                <div class="bg-gradient-to-r from-cyan-900 via-sky-950 to-slate-900 p-6 rounded-2xl text-white shadow-xl flex flex-wrap items-center justify-between gap-4">
                    <div class="flex items-center space-x-4">
                        <img src="/public/img/logo_institucion.jpg" class="w-14 h-14 rounded-2xl object-contain bg-white p-1 shadow-md shadow-cyan-500/30 flex-shrink-0">
                        <div>
                            <div class="flex items-center space-x-2 text-cyan-400 text-xs font-bold uppercase tracking-wider mb-1">
                                <i class="fa-solid fa-user-graduate"></i>
                                <span>Plantilla Oficial de Estudiantes • CETPRO San Miguel</span>
                            </div>
                            <h3 class="text-xl font-bold">Control de Estudiantes: Deudas y Pagos por Completar</h3>

                                    <th class="py-3.5 px-4">Persona / Rol</th>
                                    <th class="py-3.5 px-4">Sección / Encargado</th>
                                    <th class="py-3.5 px-4">Especialidad</th>
                                    <th class="py-3.5 px-4">Concepto y Nota</th>
                                    <th class="py-3.5 px-4 text-right">Cantidad (Monto)</th>
                                    <th class="py-3.5 px-4 text-center">Método</th>
                                    <th class="py-3.5 px-4 text-center">Estado</th>
                                    <th class="py-3.5 px-4 text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody id="tabla-movimientos" class="divide-y divide-slate-100 font-medium">
                                <tr>
                                    <td colspan="10" class="text-center py-8 text-slate-400">Cargando movimientos de caja...</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>


                                <tr>
                                    <td colspan="8" class="text-center py-8 text-slate-400">Cargando resultados mensuales del año...</td>
                                </tr>
                            </tbody>
                            <tfoot id="totales-resultados-dashboard" class="bg-slate-900 text-white font-extrabold border-t-2 border-slate-800">
                                <!-- Dinámico con JS -->
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>

            <!-- ======================================================== -->
            <!-- 1.1 SECCIÓN DEDICADA: RESULTADOS MES A MES               -->
            <!-- ======================================================== -->
            <div id="section-resultados" class="hidden space-y-6">
                <!-- Banner Superior -->
                <div class="bg-gradient-to-r from-emerald-950 via-slate-900 to-teal-950 p-6 rounded-2xl text-white shadow-xl flex flex-wrap items-center justify-between gap-4">
                    <div class="flex items-center space-x-4">
                        <img src="/public/img/logo_institucion.jpg" class="w-14 h-14 rounded-2xl object-contain bg-white p-1 shadow-md shadow-emerald-500/30 flex-shrink-0">
                        <div>
                            <div class="flex items-center space-x-2 text-emerald-400 text-xs font-bold uppercase tracking-wider mb-1">
                                <i class="fa-solid fa-calendar-check"></i>
                                <span>Reporte Oficial del Ejercicio Fiscal • CETPRO San Miguel</span>
                            </div>
                            <h3 class="text-xl font-bold">Estado Consolidado de Resultados: Cuánto Ingresó y Salió Mes a Mes</h3>
                            <p class="text-xs text-slate-300 mt-1">Supervisión detallada de ingresos por matrículas/cuotas, egresos por honorarios y gastos operativos, evaluando el superávit mensual de la institución.</p>
                        </div>
                    </div>

                    <div class="flex items-center space-x-3">
                        <button onclick="exportarResultadosExcel()" class="bg-emerald-600 hover:bg-emerald-500 text-white font-bold px-4 py-2.5 rounded-xl text-xs flex items-center space-x-2 shadow-lg shadow-emerald-600/30 transition">
                            <i class="fa-solid fa-file-excel"></i>
                            <span>Exportar Estado de Resultados (Excel)</span>
                        </button>
                        <button onclick="abrirModalImprimirResultados()" class="bg-sky-600 hover:bg-sky-500 text-white font-bold px-4 py-2.5 rounded-xl text-xs flex items-center space-x-2 shadow-lg shadow-sky-600/30 transition">
                            <i class="fa-solid fa-print"></i>
                            <span>Imprimir Reporte Oficial</span>
                        </button>
                    </div>
                </div>

                <!-- Tarjetas Resumen de Resultados -->
                <div class="grid grid-cols-1 md:grid-cols-4 gap-5">
                    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm">
                        <span class="text-[11px] font-bold text-slate-400 uppercase">Mes con Mayor Ingreso</span>
                        <h4 id="res-mejor-mes-nombre" class="text-lg font-extrabold text-emerald-600 mt-1">--</h4>
                        <p id="res-mejor-mes-monto" class="text-xs text-slate-500 font-semibold">S/. 0.00</p>
                    </div>

                    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm">
                        <span class="text-[11px] font-bold text-slate-400 uppercase">Mes con Mayor Gasto</span>
                        <h4 id="res-mayor-gasto-nombre" class="text-lg font-extrabold text-rose-600 mt-1">--</h4>
                        <p id="res-mayor-gasto-monto" class="text-xs text-slate-500 font-semibold">S/. 0.00</p>
                    </div>

                    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm">
                        <span class="text-[11px] font-bold text-slate-400 uppercase">Promedio Ingreso Mensual</span>
                        <h4 id="res-promedio-ingreso" class="text-lg font-extrabold text-slate-800 mt-1">S/. 0.00</h4>
                        <p class="text-xs text-emerald-600 font-medium">Recaudación media</p>
                    </div>

                    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm">
                        <span class="text-[11px] font-bold text-slate-400 uppercase">Rentabilidad / Margen Anual</span>
                        <h4 id="res-margen-anual" class="text-lg font-extrabold text-sky-700 mt-1">0.0%</h4>
                        <p id="res-estado-global" class="text-xs text-emerald-600 font-bold">Superávit Global</p>
                    </div>
                </div>

                <!-- Tabla de Resultados Completa -->
                <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse text-xs">
                            <thead>
                                <tr class="bg-slate-100/90 border-b border-slate-200 text-slate-600 font-bold uppercase tracking-wider text-[11px]">
                                    <th class="py-3.5 px-4">Mes del Año</th>
                                    <th class="py-3.5 px-4 text-right">Dinero Ingresado (Entradas)</th>
                                    <th class="py-3.5 px-4 text-right">Dinero Salido (Egresos)</th>
                                    <th class="py-3.5 px-4 text-right font-extrabold">Resultado Neto del Mes</th>
                                    <th class="py-3.5 px-4 text-center">Margen Operativo</th>
                                    <th class="py-3.5 px-4 text-center">Estado Financiero</th>
                                    <th class="py-3.5 px-4 text-right font-bold">Saldo Acumulado en Caja</th>
                                    <th class="py-3.5 px-4 text-center">Acción</th>
                                </tr>
                            </thead>
                            <tbody id="tabla-resultados-dedicada" class="divide-y divide-slate-100 font-medium">
                                <tr>
                                    <td colspan="8" class="text-center py-8 text-slate-400">Cargando resultados mensuales del año...</td>
                                </tr>
                            </tbody>
                            <tfoot id="totales-resultados-dedicada" class="bg-slate-900 text-white font-extrabold border-t-2 border-slate-800">
                                <!-- Dinámico con JS -->
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>

            <!-- ========================================== -->
            <!-- 2. SECCIÓN: CAJA DE ENTRADA Y SALIDA      -->
            <!-- ========================================== -->
            <div id="section-caja" class="hidden space-y-6">
                <!-- Barra de Filtros y Búsqueda -->
                <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm flex flex-wrap gap-4 items-center justify-between">
                    <div class="flex flex-wrap gap-3 items-center flex-1">
                        <div class="relative min-w-[220px]">
                            <i class="fa-solid fa-magnifying-glass absolute left-3 top-3 text-slate-400 text-xs"></i>
                            <input type="text" id="filtro-buscar" oninput="filtrarMovimientos()" placeholder="Buscar por nombre o concepto..." class="w-full pl-9 pr-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-sky-500 focus:outline-none">
                        </div>

                        <select id="filtro-tipo" onchange="filtrarMovimientos()" class="bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-medium focus:ring-2 focus:ring-sky-500 focus:outline-none">
                            <option value="">Todos los Tipos</option>
                            <option value="Ingreso">Solo Ingresos (Entradas)</option>
                            <option value="Egreso">Solo Egresos (Salidas)</option>
                        </select>

                        <select id="filtro-rol" onchange="filtrarMovimientos()" class="bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-medium focus:ring-2 focus:ring-sky-500 focus:outline-none">
                            <option value="">Todos los Roles</option>
                            <option value="Estudiante">Estudiantes</option>
                            <option value="Docente">Docentes / Profesores</option>
                            <option value="General">General / Institucional</option>
                        </select>

                        <select id="filtro-estado" onchange="filtrarMovimientos()" class="bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-medium focus:ring-2 focus:ring-sky-500 focus:outline-none">
                            <option value="">Todos los Estados</option>
                            <option value="Pagado">Pagados</option>
                            <option value="Pendiente">Pendientes / Por Cobrar</option>
                        </select>

                        <select id="filtro-carrera" onchange="filtrarMovimientos()" class="bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-medium focus:ring-2 focus:ring-sky-500 focus:outline-none">
                            <option value="">Todas las Especialidades</option>
                            <option value="Computación e Informática">Computación e Informática</option>
                            <option value="Confección Textil">Confección Textil</option>
                            <option value="Cosmetología y Peluquería">Cosmetología y Peluquería</option>
                            <option value="Gastronomía y Pastelería">Gastronomía y Pastelería</option>
                            <option value="Electricidad y Electrónica">Electricidad y Electrónica</option>
                            <option value="Contabilidad y Finanzas">Contabilidad y Finanzas</option>
                        </select>

                        <select id="filtro-grupo" onchange="filtrarMovimientos()" class="bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-medium focus:ring-2 focus:ring-sky-500 focus:outline-none">
                            <option value="">Todos los Grupos / Secciones</option>
                        </select>

                        <select id="filtro-encargado" onchange="filtrarMovimientos()" class="bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-medium focus:ring-2 focus:ring-sky-500 focus:outline-none">
                            <option value="">Todos los Encargados</option>
                        </select>
                    </div>

                    <button onclick="abrirModalNuevoMovimiento()" class="bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2 rounded-xl text-xs font-bold flex items-center space-x-2 transition shadow-md shadow-emerald-600/20">
                        <i class="fa-solid fa-plus"></i>
                        <span>Registrar en Caja</span>
                    </button>
                </div>

                <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">

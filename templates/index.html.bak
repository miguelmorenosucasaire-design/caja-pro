<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>CETPRO San Miguel - Gestión de Caja y Finanzas Institucionales</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#f0f7ff',
                            100: '#e0effe',
                            500: '#0284c7',
                            600: '#0369a1',
                            700: '#075985',
                            800: '#0c4a6e',
                            900: '#082f49',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        @media print {
            body * {
                visibility: hidden;
            }
            #printable-receipt, #printable-receipt *,
            #printable-student-receipt, #printable-student-receipt *,
            #printable-resultados, #printable-resultados * {
                visibility: visible;
            }
            #printable-receipt, #printable-student-receipt, #printable-resultados {
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
                margin: 0;
                padding: 24px;
                background: white;
            }
        }
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background-color: #cbd5e1;
            border-radius: 9999px;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 antialiased font-sans flex h-screen overflow-hidden">

    <!-- SIDEBAR -->
    <aside class="w-64 bg-slate-900 text-white flex flex-col flex-shrink-0 z-20 shadow-xl">
        <!-- Logo Institución CETPRO San Miguel -->
        <div class="p-4 border-b border-slate-800 flex items-center space-x-3">
            <img src="/public/img/logo_institucion.jpg" alt="Insignia CETPRO San Miguel" class="w-12 h-12 rounded-xl object-contain bg-white p-0.5 shadow-lg shadow-sky-500/20 flex-shrink-0">
            <div class="min-w-0">
                <h1 class="font-bold text-sm tracking-tight leading-tight text-white truncate">CETPRO San Miguel</h1>
                <p class="text-[11px] text-cyan-400 font-semibold truncate">Micaela Bastidas Puyucama</p>
                <p class="text-[9px] text-slate-400 truncate">Tecnología • Capacitación • Prod.</p>
            </div>
        </div>

        <!-- Botón Acción Rápida -->
        <div class="px-4 py-4">
            <button onclick="abrirModalNuevoMovimiento()" class="w-full bg-gradient-to-r from-sky-500 to-blue-600 hover:from-sky-400 hover:to-blue-500 text-white font-semibold py-2.5 px-4 rounded-xl shadow-lg shadow-sky-500/25 flex items-center justify-center space-x-2 transition-all transform active:scale-95 text-sm">
                <i class="fa-solid fa-circle-plus"></i>
                <span>Nuevo Movimiento</span>
            </button>
        </div>

        <!-- Menú de Navegación -->
        <nav class="flex-1 px-3 space-y-1.5 overflow-y-auto custom-scrollbar">
            <button onclick="cambiarSeccion('dashboard')" id="nav-dashboard" class="nav-item w-full flex items-center space-x-3 px-3.5 py-2.5 rounded-xl font-medium text-sm transition-all text-white bg-slate-800 shadow-sm">
                <i class="fa-solid fa-chart-pie w-5 text-sky-400"></i>
                <span>Panel de Control</span>
            </button>

            <button onclick="cambiarSeccion('resultados')" id="nav-resultados" class="nav-item w-full flex items-center space-x-3 px-3.5 py-2.5 rounded-xl font-medium text-sm transition-all text-slate-300 hover:text-white hover:bg-slate-800/60">
                <i class="fa-solid fa-calendar-check w-5 text-emerald-400"></i>
                <span>Resultados Mes a Mes</span>
                <span class="ml-auto bg-emerald-500/20 text-emerald-300 text-[10px] px-2 py-0.5 rounded-full font-bold">12 Meses</span>
            </button>

            <button onclick="cambiarSeccion('caja')" id="nav-caja" class="nav-item w-full flex items-center space-x-3 px-3.5 py-2.5 rounded-xl font-medium text-sm transition-all text-slate-300 hover:text-white hover:bg-slate-800/60">
                <i class="fa-solid fa-cash-register w-5 text-emerald-400"></i>
                <span>Caja de Entrada y Salida</span>
            </button>

            <button onclick="cambiarSeccion('estudiantes')" id="nav-estudiantes" class="nav-item w-full flex items-center space-x-3 px-3.5 py-2.5 rounded-xl font-medium text-sm transition-all text-slate-300 hover:text-white hover:bg-slate-800/60">
                <i class="fa-solid fa-user-graduate w-5 text-cyan-400"></i>
                <span>Plantilla de Estudiantes</span>
                <span id="badge-faltan-completar" class="ml-auto bg-amber-500/20 text-amber-300 text-[10px] px-2 py-0.5 rounded-full font-bold" title="Estudiantes con pagos incompletos o deudas">0</span>
            </button>

            <button onclick="cambiarSeccion('docentes')" id="nav-docentes" class="nav-item w-full flex items-center space-x-3 px-3.5 py-2.5 rounded-xl font-medium text-sm transition-all text-slate-300 hover:text-white hover:bg-slate-800/60">
                <i class="fa-solid fa-chalkboard-user w-5 text-amber-400"></i>
                <span>Plantilla de Docentes</span>
            </button>

            <button onclick="cambiarSeccion('grupos')" id="nav-grupos" class="nav-item w-full flex items-center space-x-3 px-3.5 py-2.5 rounded-xl font-medium text-sm transition-all text-slate-300 hover:text-white hover:bg-slate-800/60">
                <i class="fa-solid fa-users-rectangle w-5 text-indigo-400"></i>
                <span>Secciones por Grupo</span>
                <span id="badge-grupos-count" class="ml-auto bg-indigo-500/20 text-indigo-300 text-[10px] px-2 py-0.5 rounded-full font-bold">0</span>
            </button>

            <button onclick="cambiarSeccion('deudores')" id="nav-deudores" class="nav-item w-full flex items-center space-x-3 px-3.5 py-2.5 rounded-xl font-medium text-sm transition-all text-slate-300 hover:text-white hover:bg-slate-800/60">
                <i class="fa-solid fa-user-clock w-5 text-rose-400"></i>
                <span>Control de Vencimientos</span>
                <span id="badge-deudores-count" class="ml-auto bg-rose-500/20 text-rose-300 text-[10px] px-2 py-0.5 rounded-full font-bold">0</span>
            </button>

            <button onclick="cambiarSeccion('carreras')" id="nav-carreras" class="nav-item w-full flex items-center space-x-3 px-3.5 py-2.5 rounded-xl font-medium text-sm transition-all text-slate-300 hover:text-white hover:bg-slate-800/60">
                <i class="fa-solid fa-graduation-cap w-5 text-purple-400"></i>
                <span>Especialidades / Carreras</span>
            </button>

            <button onclick="cambiarSeccion('respaldos')" id="nav-respaldos" class="nav-item w-full flex items-center space-x-3 px-3.5 py-2.5 rounded-xl font-medium text-sm transition-all text-slate-300 hover:text-white hover:bg-slate-800/60">
                <i class="fa-solid fa-database w-5 text-teal-400"></i>
                <span>Respaldos de Base de Datos</span>
                <span id="badge-backups-count" class="ml-auto bg-teal-500/20 text-teal-300 text-[10px] px-2 py-0.5 rounded-full font-bold">0</span>
            </button>
        </nav>

        <!-- Footer Sidebar -->
        <div class="p-4 border-t border-slate-800 text-xs text-slate-400 flex items-center justify-between">
            <div class="flex items-center space-x-2">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
                <span class="text-[11px]">Servidor Node.js Activo</span>
            </div>
            <button onclick="exportarYRespaldar()" title="Exportar y Respaldar Base de Datos" class="hover:text-white transition">
                <i class="fa-solid fa-file-excel text-emerald-400 text-sm"></i>
            </button>
        </div>
    </aside>

    <!-- MAIN CONTENT WRAPPER -->
    <div class="flex-1 flex flex-col h-screen overflow-hidden">

        <!-- HEADER SUPERIOR -->
        <header class="bg-white border-b border-slate-200/80 px-8 py-3.5 flex items-center justify-between shadow-sm z-10 flex-shrink-0">
            <div class="flex items-center space-x-3">
                <img src="/public/img/logo_institucion.jpg" alt="Logo" class="w-8 h-8 rounded-lg object-contain bg-slate-50 border border-slate-200 hidden md:block">
                <div>
                    <h2 id="page-title" class="text-lg font-bold text-slate-800 leading-tight">Panel Financiero General</h2>
                    <p id="page-subtitle" class="text-[11px] text-slate-500 font-medium">CETPRO San Miguel - Micaela Bastidas Puyucama</p>
                </div>
            </div>
            <div class="flex items-center space-x-3">
                <button onclick="exportarYRespaldar()" class="bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border border-emerald-200 px-3.5 py-2 rounded-xl text-xs font-bold flex items-center space-x-2 transition shadow-sm">
                    <i class="fa-solid fa-download text-emerald-600"></i>
                    <span>Exportar y Respaldar BD</span>
                </button>
                <button onclick="cambiarSeccion('respaldos')" class="bg-slate-100 hover:bg-slate-200 text-slate-700 px-3.5 py-2 rounded-xl text-xs font-semibold flex items-center space-x-2 transition">
                    <i class="fa-solid fa-database text-teal-600"></i>
                    <span>Ver Respaldos</span>
                </button>
                <button onclick="cargarTodo()" class="bg-sky-50 hover:bg-sky-100 text-sky-700 px-3.5 py-2 rounded-xl text-xs font-semibold flex items-center space-x-2 transition">
                    <i class="fa-solid fa-rotate text-sky-600"></i>
                    <span>Actualizar</span>
                </button>
            </div>
        </header>
        <!-- BARRA SUPERIOR DE ACCESO RÁPIDO A SECCIONES Y MÓDULOS -->
        <div class="bg-white border-b border-slate-200 px-8 py-3 flex items-center space-x-2.5 overflow-x-auto shadow-sm flex-shrink-0 z-10">
            <span class="text-xs font-bold text-slate-400 uppercase tracking-wider mr-2 hidden md:inline-flex items-center">
                <i class="fa-solid fa-layer-group mr-1.5 text-indigo-500"></i> Secciones:
            </span>

            <button onclick="cambiarSeccion('grupos')" id="top-nav-grupos" class="top-nav-btn px-4 py-2 rounded-xl text-xs font-bold flex items-center space-x-2 bg-indigo-600 text-white shadow-md shadow-indigo-500/25 transition-all transform active:scale-95">
                <i class="fa-solid fa-users-rectangle text-sm"></i>
                <span>SECCIONES POR GRUPO</span>
                <span class="bg-white/25 text-white text-[10px] px-2 py-0.5 rounded-full font-extrabold" id="top-badge-grupos">6</span>
            </button>

            <button onclick="cambiarSeccion('dashboard')" id="top-nav-dashboard" class="top-nav-btn px-4 py-2 rounded-xl text-xs font-bold flex items-center space-x-2 bg-slate-100 hover:bg-slate-200 text-slate-700 transition-all">
                <i class="fa-solid fa-chart-pie text-sky-600"></i>
                <span>Panel General</span>
            </button>

            <button onclick="cambiarSeccion('caja')" id="top-nav-caja" class="top-nav-btn px-4 py-2 rounded-xl text-xs font-bold flex items-center space-x-2 bg-slate-100 hover:bg-slate-200 text-slate-700 transition-all">
                <i class="fa-solid fa-cash-register text-emerald-600"></i>
                <span>Caja y Recibos</span>
                <span class="bg-emerald-100 text-emerald-800 text-[10px] px-1.5 py-0.5 rounded-full font-bold">202</span>
            </button>

            <button onclick="cambiarSeccion('estudiantes')" id="top-nav-estudiantes" class="top-nav-btn px-4 py-2 rounded-xl text-xs font-bold flex items-center space-x-2 bg-slate-100 hover:bg-slate-200 text-slate-700 transition-all">
                <i class="fa-solid fa-user-graduate text-cyan-600"></i>
                <span>Plantilla Estudiantes</span>
                <span class="bg-cyan-100 text-cyan-800 text-[10px] px-1.5 py-0.5 rounded-full font-bold">147</span>
            </button>

            <button onclick="cambiarSeccion('docentes')" id="top-nav-docentes" class="top-nav-btn px-4 py-2 rounded-xl text-xs font-bold flex items-center space-x-2 bg-slate-100 hover:bg-slate-200 text-slate-700 transition-all">
                <i class="fa-solid fa-chalkboard-user text-amber-600"></i>
                <span>Docentes y Encargados</span>
                <span class="bg-amber-100 text-amber-800 text-[10px] px-1.5 py-0.5 rounded-full font-bold">6</span>
            </button>

            <button onclick="cambiarSeccion('resultados')" id="top-nav-resultados" class="top-nav-btn px-4 py-2 rounded-xl text-xs font-bold flex items-center space-x-2 bg-slate-100 hover:bg-slate-200 text-slate-700 transition-all">
                <i class="fa-solid fa-calendar-check text-indigo-600"></i>
                <span>Resultados Mes a Mes</span>
            </button>

            <button onclick="cambiarSeccion('respaldos')" id="top-nav-respaldos" class="top-nav-btn px-4 py-2 rounded-xl text-xs font-bold flex items-center space-x-2 bg-slate-100 hover:bg-slate-200 text-slate-700 transition-all">
                <i class="fa-solid fa-database text-teal-600"></i>
                <span>Respaldos de BD</span>
            </button>
        </div>


        <!-- BODY SECTIONS SCROLLABLE -->
        <main class="flex-1 overflow-y-auto p-8 custom-scrollbar bg-slate-50/60">

            <!-- ========================================== -->
            <!-- 1. SECCIÓN: DASHBOARD (PANEL GENERAL)      -->
            <!-- ========================================== -->
            <div id="section-dashboard" class="space-y-6">
                <!-- Tarjetas KPI -->
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
                    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md transition">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Saldo Total en Caja</span>
                            <div class="w-10 h-10 rounded-xl bg-sky-50 text-sky-600 flex items-center justify-center">
                                <i class="fa-solid fa-wallet text-lg"></i>
                            </div>
                        </div>
                        <div class="mt-3">
                            <h3 id="kpi-saldo" class="text-2xl font-extrabold text-slate-900">S/. 0.00</h3>
                            <p class="text-xs text-emerald-600 font-semibold mt-1 flex items-center">
                                <i class="fa-solid fa-arrow-trend-up mr-1"></i> Balance Neto Real
                            </p>
                        </div>
                    </div>

                    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md transition">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Total Ingresos</span>
                            <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
                                <i class="fa-solid fa-circle-arrow-down text-lg"></i>
                            </div>
                        </div>
                        <div class="mt-3">
                            <h3 id="kpi-ingresos" class="text-2xl font-extrabold text-emerald-600">S/. 0.00</h3>
                            <p id="kpi-ingresos-mes" class="text-xs text-slate-500 font-medium mt-1">Este mes: S/. 0.00</p>
                        </div>
                    </div>

                    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md transition">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Total Salidas / Egresos</span>
                            <div class="w-10 h-10 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center">
                                <i class="fa-solid fa-circle-arrow-up text-lg"></i>
                            </div>
                        </div>
                        <div class="mt-3">
                            <h3 id="kpi-egresos" class="text-2xl font-extrabold text-rose-600">S/. 0.00</h3>
                            <p id="kpi-egresos-mes" class="text-xs text-slate-500 font-medium mt-1">Este mes: S/. 0.00</p>
                        </div>
                    </div>

                    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm hover:shadow-md transition cursor-pointer" onclick="cambiarSeccion('estudiantes')">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Saldos por Cobrar</span>
                            <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center">
                                <i class="fa-solid fa-clock-rotate-left text-lg"></i>
                            </div>
                        </div>
                        <div class="mt-3">
                            <h3 id="kpi-deudas" class="text-2xl font-extrabold text-amber-600">S/. 0.00</h3>
                            <p class="text-xs text-amber-700 font-semibold mt-1 flex items-center">
                                <i class="fa-solid fa-user-graduate mr-1"></i> Estudiantes pendientes y parciales
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Gráfico Anual y Resumen Docente -->
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <div class="lg:col-span-2 bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm">
                        <div class="flex items-center justify-between mb-4">
                            <div>
                                <h4 class="font-bold text-slate-800 text-base">Evolución Financiera Mes a Mes</h4>
                                <p class="text-xs text-slate-500">Comparativa de dinero ingresado vs dinero salido durante el año</p>
                            </div>
                            <span class="bg-sky-50 text-sky-700 text-xs font-bold px-2.5 py-1 rounded-lg">Año Actual</span>
                        </div>
                        <div class="h-72">
                            <canvas id="chart-mensual"></canvas>
                        </div>
                    </div>

                    <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm flex flex-col justify-between">
                        <div>
                            <div class="flex items-center justify-between mb-4">
                                <h4 class="font-bold text-slate-800 text-base">Flujo de Docentes</h4>
                                <button onclick="cambiarSeccion('docentes')" class="text-xs font-bold text-sky-600 hover:text-sky-700">Ver Plantilla &rarr;</button>
                            </div>
                            <p class="text-xs text-slate-500 mb-5">Pagos de honorarios vs ingresos generados por los profesores</p>
                            
                            <div class="space-y-4">
                                <div class="p-4 rounded-xl bg-slate-50 border border-slate-100 flex items-center justify-between">
                                    <div class="flex items-center space-x-3">
                                        <div class="w-8 h-8 rounded-lg bg-rose-100 text-rose-600 flex items-center justify-center text-xs">
                                            <i class="fa-solid fa-arrow-up"></i>
                                        </div>
                                        <div>
                                            <p class="text-xs font-bold text-slate-600">Salidas / Pagos a Docentes</p>
                                            <p class="text-xs text-slate-400">Honorarios, sueldos y horas</p>
                                        </div>
                                    </div>
                                    <span id="kpi-docentes-salidas" class="font-bold text-rose-600 text-sm">S/. 0.00</span>
                                </div>

                                <div class="p-4 rounded-xl bg-slate-50 border border-slate-100 flex items-center justify-between">
                                    <div class="flex items-center space-x-3">
                                        <div class="w-8 h-8 rounded-lg bg-emerald-100 text-emerald-600 flex items-center justify-center text-xs">
                                            <i class="fa-solid fa-arrow-down"></i>
                                        </div>
                                        <div>
                                            <p class="text-xs font-bold text-slate-600">Ingresos Generados</p>
                                            <p class="text-xs text-slate-400">Talleres, módulos y proyectos</p>
                                        </div>
                                    </div>
                                    <span id="kpi-docentes-entradas" class="font-bold text-emerald-600 text-sm">S/. 0.00</span>
                                </div>

                                <div class="p-4 rounded-xl bg-sky-50 border border-sky-100 flex items-center justify-between">
                                    <div>
                                        <p class="text-xs font-bold text-sky-900">Balance Neto Docente</p>
                                        <p class="text-xs text-sky-600">Diferencia institucional</p>
                                    </div>
                                    <span id="kpi-docentes-balance" class="font-extrabold text-sky-800 text-base">S/. 0.00</span>
                                </div>
                            </div>
                        </div>

                        <button onclick="cambiarSeccion('docentes')" class="mt-6 w-full py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-xs rounded-xl transition flex items-center justify-center space-x-2">
                            <i class="fa-solid fa-file-invoice-dollar"></i>
                            <span>Ver Boletas y Plantilla Completa</span>
                        </button>
                    </div>
                </div>
                <!-- ======================================================== -->
                <!-- CUADRO OFICIAL DE RESULTADOS MES A MES (ENERO A DICIEMBRE) -->
                <!-- ======================================================== -->
                <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
                    <div class="p-6 bg-gradient-to-r from-slate-900 via-slate-800 to-sky-950 text-white flex flex-wrap items-center justify-between gap-4">
                        <div class="flex items-center space-x-3.5">
                            <div class="w-12 h-12 rounded-xl bg-emerald-500/20 border border-emerald-400/30 flex items-center justify-center text-emerald-400 text-xl shadow-lg">
                                <i class="fa-solid fa-table-list"></i>
                            </div>
                            <div>
                                <div class="flex items-center space-x-2 text-emerald-400 text-[11px] font-bold uppercase tracking-wider">
                                    <i class="fa-solid fa-chart-line"></i>
                                    <span>Estado Financiero Consolidado • CETPRO San Miguel</span>
                                </div>
                                <h3 class="text-lg font-bold">Cuadro Oficial de Resultados: Cuánto Ingresó y Salió Mes a Mes</h3>
                                <p class="text-xs text-slate-300">Desglose exacto de entradas, salidas, resultado neto mensual y saldo acumulado en caja durante el año <span id="label-ano-resultados">2026</span></p>
                            </div>
                        </div>

                        <div class="flex items-center space-x-2.5">
                            <button onclick="exportarResultadosExcel()" class="bg-emerald-600 hover:bg-emerald-500 text-white px-3.5 py-2 rounded-xl text-xs font-bold flex items-center space-x-1.5 transition shadow-lg shadow-emerald-600/30">
                                <i class="fa-solid fa-file-excel"></i>
                                <span>Exportar a Excel (.CSV)</span>
                            </button>
                            <button onclick="abrirModalImprimirResultados()" class="bg-sky-600 hover:bg-sky-500 text-white px-3.5 py-2 rounded-xl text-xs font-bold flex items-center space-x-1.5 transition shadow-lg shadow-sky-600/30">
                                <i class="fa-solid fa-print"></i>
                                <span>Imprimir Reporte</span>
                            </button>
                        </div>
                    </div>

                    <!-- Tabla de Resultados Mes a Mes -->
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse text-xs">
                            <thead>
                                <tr class="bg-slate-100/90 border-b border-slate-200 text-slate-600 font-bold uppercase tracking-wider text-[11px]">
                                    <th class="py-3.5 px-4">Mes del Año</th>
                                    <th class="py-3.5 px-4 text-right">Dinero Ingresado (Entradas)</th>
                                    <th class="py-3.5 px-4 text-right">Dinero Salido (Egresos)</th>

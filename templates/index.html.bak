                        </div>
                    </div>

                    <div class="bg-white p-4 rounded-xl border border-rose-200 bg-rose-50/30 shadow-sm flex items-center space-x-3">
                        <div class="w-10 h-10 rounded-xl bg-rose-100 text-rose-700 flex items-center justify-center text-lg">
                            <i class="fa-solid fa-hand-holding-dollar"></i>
                        </div>
                        <div>
                            <p class="text-[11px] font-bold text-rose-800 uppercase">Deuda Total (0% Abono)</p>
                            <h4 id="est-deben-todo" class="text-lg font-extrabold text-rose-600">0 Alumnos</h4>
                        </div>
                    </div>

                    <div class="bg-white p-4 rounded-xl border border-emerald-200 bg-emerald-50/30 shadow-sm flex items-center space-x-3">
                        <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center text-lg">
                            <i class="fa-solid fa-circle-check"></i>
                        </div>
                        <div>
                            <p class="text-[11px] font-bold text-emerald-800 uppercase">Saldos por Cobrar</p>
                            <h4 id="est-saldo-restante" class="text-lg font-extrabold text-emerald-700">S/. 0.00</h4>
                        </div>
                    </div>
                </div>

                <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm flex flex-wrap gap-4 items-center justify-between">
                    <div class="flex flex-wrap gap-3 items-center flex-1">
                        <div class="relative min-w-[240px]">
                            <i class="fa-solid fa-magnifying-glass absolute left-3 top-3 text-slate-400 text-xs"></i>
                            <input type="text" id="filtro-estudiantes-buscar" oninput="filtrarEstudiantesFrontend()" placeholder="Buscar alumno por nombre o código..." class="w-full pl-9 pr-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-cyan-500 focus:outline-none">
                        </div>

                        <select id="filtro-estudiantes-carrera" onchange="cargarEstudiantes()" class="bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-semibold text-slate-700 focus:ring-2 focus:ring-cyan-500 focus:outline-none min-w-[200px]">
                            <option value="">Todas las Especialidades</option>
                            <option value="Computación e Informática">Computación e Informática</option>
                            <option value="Confección Textil">Confección Textil</option>
                            <option value="Cosmetología y Peluquería">Cosmetología y Peluquería</option>
                            <option value="Gastronomía y Pastelería">Gastronomía y Pastelería</option>
                            <option value="Electricidad y Electrónica">Electricidad y Electrónica</option>
                            <option value="Contabilidad y Finanzas">Contabilidad y Finanzas</option>
                        </select>

                        <select id="filtro-estudiantes-estado" onchange="cargarEstudiantes()" class="bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-semibold text-slate-700 focus:ring-2 focus:ring-cyan-500 focus:outline-none min-w-[200px]">
                            <option value="">Todos los Estados Financieros</option>
                            <option value="faltan_completar">🟠 Solo los que Faltan Completar (Abono Parcial)</option>
                            <option value="deben_todo">🔴 Solo los que Deben Todo (Sin Abonos)</option>
                            <option value="al_dia">🟢 Solo los que están Al Día (100% Pagado)</option>
                        </select>
                    </div>

                    <div class="flex items-center space-x-2 bg-slate-100 p-1 rounded-xl">
                        <button onclick="setModoVistaEstudiantes('grid')" id="btn-vista-grid" class="px-3 py-1.5 rounded-lg text-xs font-bold bg-white text-slate-800 shadow-sm">
                            <i class="fa-solid fa-grip mr-1"></i> Tarjetas
                        </button>
                        <button onclick="setModoVistaEstudiantes('table')" id="btn-vista-table" class="px-3 py-1.5 rounded-lg text-xs font-medium text-slate-500 hover:text-slate-800">
                            <i class="fa-solid fa-table-list mr-1"></i> Tabla
                        </button>
                    </div>
                </div>

                <div id="grid-estudiantes" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    <!-- Dinámico con JS -->
                </div>

                <div id="tabla-estudiantes-container" class="hidden bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse text-xs">
                            <thead>
                                <tr class="bg-slate-50/80 border-b border-slate-200 text-slate-500 font-bold uppercase tracking-wider">
                                    <th class="py-3.5 px-4">Estudiante / Código</th>
                                    <th class="py-3.5 px-4">Especialidad y Módulo</th>
                                    <th class="py-3.5 px-4 text-right">Total Acordado</th>
                                    <th class="py-3.5 px-4 text-right">Ya Abonado</th>
                                    <th class="py-3.5 px-4 text-right text-rose-600 font-extrabold">Falta Completar</th>
                                    <th class="py-3.5 px-4 text-center">Avance</th>
                                    <th class="py-3.5 px-4 text-center">Estado Financiero</th>
                                    <th class="py-3.5 px-4 text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody id="tbody-estudiantes" class="divide-y divide-slate-100 font-medium">
                                <tr>
                                    <td colspan="8" class="text-center py-8 text-slate-400">Cargando plantilla de estudiantes...</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- ======================================================== -->
            <!-- 4. SECCIÓN: PLANTILLA PROFESIONAL DE DOCENTES           -->
            <!-- ======================================================== -->
            <div id="section-docentes" class="hidden space-y-6">
                <div class="bg-gradient-to-r from-slate-900 to-indigo-950 p-6 rounded-2xl text-white shadow-lg flex flex-wrap items-center justify-between gap-4">
                    <div>
                        <div class="flex items-center space-x-2 text-sky-400 text-xs font-bold uppercase tracking-wider mb-1">
                            <i class="fa-solid fa-award"></i>
                            <span>Plantilla Profesional del Cuerpo Docente • CETPRO San Miguel</span>
                        </div>
                        <h3 class="text-xl font-bold">Gestión de Honorarios, Módulos e Ingresos por Profesor</h3>
                        <p class="text-xs text-slate-300 mt-1">Control exacto de cuánto sale en pagos y cuánto dinero ingresa a la institución por actividades de cada profesor.</p>
                    </div>

                    <div class="flex items-center space-x-3">
                        <select id="filtro-docentes-carrera" onchange="cargarDocentes()" class="bg-slate-800 text-white border border-slate-700 rounded-xl px-3 py-2 text-xs font-medium focus:outline-none">
                            <option value="">Filtrar por Especialidad (Todas)</option>
                            <option value="Computación e Informática">Computación e Informática</option>
                            <option value="Confección Textil">Confección Textil</option>
                            <option value="Cosmetología y Peluquería">Cosmetología y Peluquería</option>
                            <option value="Gastronomía y Pastelería">Gastronomía y Pastelería</option>
                            <option value="Electricidad y Electrónica">Electricidad y Electrónica</option>
                            <option value="Contabilidad y Finanzas">Contabilidad y Finanzas</option>
                        </select>
                    </div>
                </div>

                <div id="grid-docentes" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"></div>
            </div>

            <!-- ======================================================== -->
            <!-- 5. SECCIÓN: CONTROL DE VENCIMIENTOS / DEUDORES          -->
            <!-- ======================================================== -->
            <div id="section-deudores" class="hidden space-y-6">
                <div class="bg-amber-50 border border-amber-200 p-5 rounded-2xl flex items-start space-x-4">
                    <div class="w-10 h-10 rounded-xl bg-amber-500 text-white flex items-center justify-center flex-shrink-0 shadow-md shadow-amber-500/20">
                        <i class="fa-solid fa-clock-rotate-left text-lg"></i>
                    </div>
                    <div class="flex-1">
                        <h4 class="font-bold text-amber-900 text-sm">Control Preventivo de Periodos de Pago de Estudiantes</h4>
                        <p class="text-xs text-amber-800 mt-0.5">Esta sección monitorea a los estudiantes antes de que se venza su periodo de pago. Te permite filtrar por carrera y realizar cobranzas rápidas directamente hacia la caja de la institución.</p>
                    </div>
                </div>

                <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm flex flex-wrap gap-4 items-center justify-between">
                    <div class="flex items-center space-x-3">
                        <span class="text-xs font-bold text-slate-500 uppercase tracking-wider">Seleccionar Especialidad:</span>
                        <select id="filtro-deudores-carrera" onchange="cargarDeudores()" class="bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 text-xs font-semibold text-slate-700 focus:ring-2 focus:ring-sky-500 focus:outline-none min-w-[240px]">
                            <option value="">Todas las Especialidades</option>
                            <option value="Computación e Informática">Computación e Informática</option>
                            <option value="Confección Textil">Confección Textil</option>
                            <option value="Cosmetología y Peluquería">Cosmetología y Peluquería</option>
                            <option value="Gastronomía y Pastelería">Gastronomía y Pastelería</option>
                            <option value="Electricidad y Electrónica">Electricidad y Electrónica</option>
                            <option value="Contabilidad y Finanzas">Contabilidad y Finanzas</option>
                        </select>
                    </div>

                    <div class="flex items-center space-x-4 text-xs font-semibold">
                        <div class="flex items-center space-x-1.5 text-rose-600">
                            <span class="w-2.5 h-2.5 rounded-full bg-rose-500"></span>
                            <span>Vencido</span>
                        </div>
                        <div class="flex items-center space-x-1.5 text-amber-600">
                            <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
                            <span>Próximo a Vencer (&le; 7 días)</span>
                        </div>
                        <div class="flex items-center space-x-1.5 text-emerald-600">
                            <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
                            <span>En Plazo Normal</span>
                        </div>
                    </div>
                </div>

                <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse text-xs">
                            <thead>
                                <tr class="bg-slate-50/80 border-b border-slate-200 text-slate-500 font-bold uppercase tracking-wider">
                                    <th class="py-3.5 px-4">Estudiante</th>
                                    <th class="py-3.5 px-4">Especialidad Asignada</th>
                                    <th class="py-3.5 px-4">Concepto Pendiente</th>
                                    <th class="py-3.5 px-4 text-right">Saldo a Completar</th>
                                    <th class="py-3.5 px-4 text-center">Fecha Límite</th>
                                    <th class="py-3.5 px-4 text-center">Estado del Periodo</th>
                                    <th class="py-3.5 px-4 text-center">Acción de Cobro</th>
                                </tr>
                            </thead>
                            <tbody id="tabla-deudores" class="divide-y divide-slate-100 font-medium">
                                <tr>
                                    <td colspan="7" class="text-center py-8 text-slate-400">Cargando lista de estudiantes con pagos pendientes...</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- ======================================================== -->
            <!-- 6. SECCIÓN: REPORTE POR ESPECIALIDADES / CARRERAS        -->
            <!-- ======================================================== -->
            <div id="section-carreras" class="hidden space-y-6">
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="grid-carreras-reporte"></div>
            </div>

            <!-- =================================================================== -->
            <!-- 7. SECCIÓN: SISTEMA DE RESPALDOS DE BASE DE DATOS (NUEVA)           -->
            <!-- =================================================================== -->
            <div id="section-respaldos" class="hidden space-y-6">
                <!-- Banner Superior de Respaldos -->
                <div class="bg-gradient-to-r from-teal-900 via-slate-900 to-indigo-950 p-6 rounded-2xl text-white shadow-xl flex flex-wrap items-center justify-between gap-4">
                    <div class="flex items-center space-x-4">
                        <div class="w-12 h-12 rounded-2xl bg-teal-500/20 border border-teal-400/40 text-teal-400 flex items-center justify-center text-2xl shadow-lg">
                            <i class="fa-solid fa-shield-halved"></i>
                        </div>
                        <div>
                            <div class="flex items-center space-x-2 text-teal-400 text-xs font-bold uppercase tracking-wider mb-1">
                                <i class="fa-solid fa-database"></i>
                                <span>Centro de Seguridad y Respaldos • CETPRO San Miguel</span>
                            </div>
                            <h3 class="text-xl font-bold">Copias de Seguridad y Respaldos de la Base de Datos</h3>
                            <p class="text-xs text-slate-300 mt-1">Se genera un respaldo automático protegido cada vez que exportas la BD. Puedes descargarlos o eliminarlos cuando ya no los necesites.</p>
                        </div>
                    </div>

                    <div class="flex items-center space-x-3">
                        <button onclick="crearRespaldoManual()" class="bg-gradient-to-r from-teal-500 to-emerald-600 hover:from-teal-400 hover:to-emerald-500 text-white font-bold px-4 py-2.5 rounded-xl text-xs flex items-center space-x-2 shadow-lg shadow-teal-500/30 transition">
                            <i class="fa-solid fa-plus-circle"></i>
                            <span>Crear Respaldo Ahora (.db y .csv)</span>
                        </button>
                    </div>
                </div>

                <!-- Resumen de Respaldos -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
                    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm flex items-center space-x-4">
                        <div class="w-12 h-12 rounded-xl bg-teal-50 text-teal-600 flex items-center justify-center text-xl">
                            <i class="fa-solid fa-server"></i>
                        </div>
                        <div>
                            <p class="text-[11px] font-bold text-slate-400 uppercase">Respaldos Almacenados</p>
                            <h4 id="backups-total-count" class="text-2xl font-extrabold text-slate-800">0</h4>
                            <p class="text-[11px] text-teal-600 font-semibold mt-0.5">Copias en carpeta /backups</p>
                        </div>
                    </div>

                    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm flex items-center space-x-4">
                        <div class="w-12 h-12 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-xl">
                            <i class="fa-solid fa-clock-rotate-left"></i>
                        </div>
                        <div>
                            <p class="text-[11px] font-bold text-slate-400 uppercase">Último Respaldo Generado</p>
                            <h4 id="backups-ultimo-fecha" class="text-sm font-extrabold text-slate-800 truncate">--</h4>
                            <p class="text-[11px] text-slate-500 font-medium mt-0.5" id="backups-ultimo-nombre">Sin respaldos aún</p>
                        </div>
                    </div>

                    <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm flex items-center space-x-4">
                        <div class="w-12 h-12 rounded-xl bg-sky-50 text-sky-600 flex items-center justify-center text-xl">
                            <i class="fa-solid fa-hard-drive"></i>
                        </div>
                        <div>
                            <p class="text-[11px] font-bold text-slate-400 uppercase">Espacio Total Utilizado</p>
                            <h4 id="backups-total-size" class="text-2xl font-extrabold text-slate-800">0 KB</h4>
                            <p class="text-[11px] text-sky-600 font-semibold mt-0.5">Archivos .db y .csv protegidos</p>
                        </div>
                    </div>
                </div>

                <!-- Tabla de Respaldos -->
                <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
                    <div class="p-4 bg-slate-50 border-b border-slate-200 flex items-center justify-between">
                        <div class="flex items-center space-x-2">
                            <i class="fa-solid fa-list-check text-slate-500"></i>
                            <h4 class="font-bold text-slate-800 text-xs">Historial de Archivos de Respaldo de la Base de Datos</h4>
                        </div>
                        <span class="text-[11px] text-slate-400 font-medium">Puedes descargar una copia o eliminar los respaldos antiguos cuando desees</span>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse text-xs">
                            <thead>
                                <tr class="bg-slate-50/50 border-b border-slate-200 text-slate-500 font-bold uppercase tracking-wider">
                                    <th class="py-3 px-4">Nombre del Archivo de Respaldo</th>
                                    <th class="py-3 px-4">Formato / Tipo</th>
                                    <th class="py-3 px-4">Fecha y Hora de Creación</th>
                                    <th class="py-3 px-4 text-right">Tamaño</th>
                                    <th class="py-3 px-4 text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody id="tabla-respaldos" class="divide-y divide-slate-100 font-medium">
                                <tr>
                                    <td colspan="5" class="text-center py-8 text-slate-400">Cargando lista de respaldos del servidor...</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </main>
    </div>

    <!-- =================================================================== -->
    <!-- MODAL 1: FICHA / PLANTILLA PROFESIONAL DEL ESTUDIANTE (IMPRIMIBLE) -->
    <!-- =================================================================== -->
    <div id="modal-ficha-estudiante" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
        <div class="bg-white w-full max-w-3xl rounded-2xl shadow-2xl border border-slate-100 overflow-hidden transform transition-all flex flex-col max-h-[92vh]">
            <div class="p-4 bg-slate-900 text-white flex items-center justify-between no-print">
                <div class="flex items-center space-x-2">
                    <i class="fa-solid fa-file-invoice text-cyan-400 text-lg"></i>
                    <h3 class="font-bold text-sm">Ficha y Estado de Cuenta Oficial del Estudiante</h3>
                </div>
                <div class="flex items-center space-x-2">
                    <button onclick="window.print()" class="bg-cyan-600 hover:bg-cyan-500 text-white px-3.5 py-1.5 rounded-lg text-xs font-semibold flex items-center space-x-1.5 transition">
                        <i class="fa-solid fa-print"></i>
                        <span>Imprimir / Guardar en PDF</span>
                    </button>
                    <button onclick="cerrarModalFichaEstudiante()" class="text-slate-400 hover:text-white p-1">
                        <i class="fa-solid fa-xmark text-lg"></i>
                    </button>
                </div>
            </div>

            <div id="printable-student-receipt" class="p-8 overflow-y-auto flex-1 custom-scrollbar text-xs bg-white">
                <div class="border-b-2 border-slate-900 pb-5 mb-5 flex justify-between items-start">
                    <div class="flex items-center space-x-4">
                        <img src="/public/img/logo_institucion.jpg" class="w-16 h-16 object-contain rounded-xl p-1 border border-slate-300">
                        <div>
                            <h2 class="font-black text-base text-slate-900 tracking-wide uppercase">CETPRO "SAN MIGUEL - MICAELA BASTIDAS PUYUCAMA"</h2>
                            <p class="text-slate-600 text-[11px] font-semibold">Centro de Educación Técnico Productiva • DRE / UGEL</p>
                            <p class="text-slate-400 text-[10px]">Oficina de Tesorería, Matrículas y Pensiones Académicas</p>
                        </div>
                    </div>
                    <div class="text-right">
                        <span class="bg-cyan-50 border border-cyan-200 text-cyan-800 font-bold px-3 py-1 rounded-md text-[10px] uppercase">Estado de Cuenta Oficial</span>
                        <p class="text-slate-400 text-[10px] mt-1" id="recibo-est-fecha-emision">Emisión: --/--/----</p>
                    </div>
                </div>

                <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 mb-6 grid grid-cols-2 gap-4">
                    <div>
                        <p class="text-slate-400 font-bold text-[10px] uppercase">Estudiante / Código</p>
                        <p class="font-bold text-slate-900 text-sm" id="recibo-est-nombre">Nombre del Alumno</p>
                        <p class="text-cyan-700 font-semibold mt-0.5" id="recibo-est-codigo">Código: EST-000</p>
                        <p class="text-slate-500 mt-1" id="recibo-est-carrera">Especialidad: --</p>
                    </div>
                    <div>
                        <p class="text-slate-400 font-bold text-[10px] uppercase">Ciclo / Módulo y Contacto</p>
                        <p class="font-semibold text-slate-700" id="recibo-est-ciclo">Módulo: Regular</p>
                        <p class="text-slate-500 mt-0.5" id="recibo-est-email">Correo: --</p>
                        <p class="text-slate-500" id="recibo-est-telefono">Teléfono: --</p>
                    </div>
                </div>

                <div class="grid grid-cols-3 gap-3 mb-6">
                    <div class="bg-slate-50 border border-slate-200 p-3 rounded-xl text-center">
                        <p class="text-[10px] font-bold text-slate-500 uppercase">Total Comprometido</p>
                        <p class="text-base font-extrabold text-slate-900 mt-1" id="recibo-est-total-comprometido">S/. 0.00</p>
                    </div>
                    <div class="bg-emerald-50 border border-emerald-200 p-3 rounded-xl text-center">
                        <p class="text-[10px] font-bold text-emerald-700 uppercase">Monto Ya Abonado</p>
                        <p class="text-base font-extrabold text-emerald-600 mt-1" id="recibo-est-total-pagado">S/. 0.00</p>
                    </div>
                    <div class="bg-rose-50 border border-rose-200 p-3 rounded-xl text-center">
                        <p class="text-[10px] font-bold text-rose-700 uppercase">Saldo que Falta Completar</p>
                        <p class="text-base font-extrabold text-rose-600 mt-1" id="recibo-est-saldo-pendiente">S/. 0.00</p>
                    </div>
                </div>

                <div class="mb-6">
                    <div class="flex justify-between text-[11px] font-bold mb-1">
                        <span class="text-slate-600">Porcentaje de Cobertura de Pagos</span>
                        <span id="recibo-est-porcentaje-label" class="text-cyan-700">0%</span>
                    </div>
                    <div class="w-full bg-slate-200 rounded-full h-3 overflow-hidden">
                        <div id="recibo-est-porcentaje-bar" class="bg-gradient-to-r from-cyan-500 to-emerald-500 h-3 rounded-full transition-all duration-500" style="width: 0%"></div>
                    </div>
                </div>

                <h4 class="font-bold text-slate-800 mb-2 uppercase tracking-wider text-[11px]">Detalle de Cuotas y Compromisos</h4>
                <div class="border border-slate-200 rounded-xl overflow-hidden mb-6">
                    <table class="w-full text-left text-[11px]">
                        <thead>
                            <tr class="bg-slate-100 border-b border-slate-200 text-slate-600 font-bold">
                                <th class="p-2.5">Concepto</th>
                                <th class="p-2.5 text-right">Costo Total</th>
                                <th class="p-2.5 text-right">Abonado</th>
                                <th class="p-2.5 text-right text-rose-600 font-extrabold">Falta Completar</th>
                                <th class="p-2.5 text-center">Vencimiento</th>
                                <th class="p-2.5 text-center">Estado</th>
                            </tr>
                        </thead>
                        <tbody id="recibo-est-tabla-movimientos" class="divide-y divide-slate-100 font-medium"></tbody>
                    </table>
                </div>

                <h4 class="font-bold text-slate-800 mb-2 uppercase tracking-wider text-[11px]">Historial de Abonos y Pagos Recibidos</h4>
                <div class="border border-slate-200 rounded-xl overflow-hidden mb-8">
                    <table class="w-full text-left text-[11px]">
                        <thead>
                            <tr class="bg-slate-100 border-b border-slate-200 text-slate-600 font-bold">
                                <th class="p-2.5">Fecha</th>
                                <th class="p-2.5">Concepto / Cuota</th>
                                <th class="p-2.5">Comprobante</th>
                                <th class="p-2.5">Método</th>
                                <th class="p-2.5 text-right">Monto Abonado</th>
                            </tr>
                        </thead>
                        <tbody id="recibo-est-tabla-abonos" class="divide-y divide-slate-100 font-medium"></tbody>
                    </table>
                </div>

                <p class="text-[10px] text-slate-400 italic mb-8">
                    * El presente documento constituye la ficha oficial de estado de cuenta emitida por la Dirección Financiera del CETPRO San Miguel.
                </p>

                <div class="grid grid-cols-2 gap-12 pt-4 border-t border-slate-200 text-center">
                    <div>
                        <div class="border-b border-slate-400 w-48 mx-auto mb-2"></div>
                        <p class="font-bold text-slate-800">Firma del Estudiante / Apoderado</p>
                        <p class="text-[10px] text-slate-400">DNI / Firma de Conformidad</p>
                    </div>
                    <div>
                        <div class="border-b border-slate-400 w-48 mx-auto mb-2"></div>
                        <p class="font-bold text-slate-800">Caja y Tesorería Central</p>
                        <p class="text-[10px] text-slate-400">CETPRO San Miguel • Sello Oficial</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- =================================================================== -->
    <!-- MODAL 2: REGISTRAR ABONO O COMPLETAR PAGO DEL ESTUDIANTE           -->
    <!-- =================================================================== -->
    <div id="modal-abonar-estudiante" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
        <div class="bg-white w-full max-w-md rounded-2xl shadow-2xl border border-slate-100 overflow-hidden transform transition-all">
            <div class="p-4 bg-gradient-to-r from-cyan-900 to-sky-950 text-white flex items-center justify-between">
                <div class="flex items-center space-x-2">
                    <i class="fa-solid fa-hand-holding-dollar text-cyan-400 text-lg"></i>
                    <h3 class="font-bold text-sm">Registrar Abono / Completar Pago</h3>
                </div>
                <button onclick="cerrarModalAbonar()" class="text-slate-400 hover:text-white p-1">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>

            <form id="form-abonar-estudiante" onsubmit="procesarAbono(event)" class="p-5 space-y-4 text-xs">
                <input type="hidden" id="abono-mov-id">
                <input type="hidden" id="abono-saldo-max">

                <div class="bg-slate-50 p-3 rounded-xl border border-slate-200 space-y-1">
                    <p class="text-slate-500 font-bold uppercase text-[10px]">Estudiante</p>
                    <p class="font-extrabold text-slate-900 text-sm" id="abono-est-nombre">--</p>
                    <p class="text-slate-600 font-medium" id="abono-concepto-nombre">Concepto: --</p>
                    
                    <div class="pt-2 mt-2 border-t border-slate-200 grid grid-cols-2 gap-2 text-center">
                        <div class="bg-white p-2 rounded-lg border border-slate-200">
                            <span class="text-[10px] text-slate-400 uppercase font-bold">Ya Abonado</span>
                            <p class="font-bold text-emerald-600 text-xs" id="abono-ya-abonado">S/. 0.00</p>
                        </div>
                        <div class="bg-rose-50 p-2 rounded-lg border border-rose-200">
                            <span class="text-[10px] text-rose-700 uppercase font-bold">Falta Completar</span>
                            <p class="font-extrabold text-rose-600 text-xs" id="abono-falta-completar">S/. 0.00</p>
                        </div>
                    </div>
                </div>

                <div class="flex items-center space-x-2">
                    <button type="button" onclick="setMontoAbonoCompleto()" class="flex-1 py-1.5 px-3 bg-amber-50 hover:bg-amber-100 text-amber-800 border border-amber-200 rounded-lg font-bold text-[11px] transition">
                        ⚡ Completar Totalidad
                    </button>
                    <button type="button" onclick="setMontoAbonoMitad()" class="flex-1 py-1.5 px-3 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg font-bold text-[11px] transition">
                        ½ Abonar 50%
                    </button>
                </div>

                <div>
                    <label class="block font-bold text-slate-700 mb-1">Monto a Abonar (S/.) *</label>
                    <input type="number" step="0.01" min="0.01" id="abono-monto-input" required class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 text-base font-extrabold text-slate-900 focus:ring-2 focus:ring-cyan-500 focus:outline-none">
                    <p class="text-[10px] text-slate-400 mt-1">Este dinero ingresará directamente a la caja chica de la institución.</p>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block font-bold text-slate-700 mb-1">Método de Pago</label>
                        <select id="abono-metodo-select" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 font-medium focus:ring-2 focus:ring-cyan-500 focus:outline-none">
                            <option value="Efectivo">Efectivo</option>
                            <option value="Yape">Yape</option>
                            <option value="Plin">Plin</option>
                            <option value="Transferencia">Transferencia Bancaria</option>
                            <option value="Tarjeta">Tarjeta de Débito/Crédito</option>
                        </select>
                    </div>

                    <div>
                        <label class="block font-bold text-slate-700 mb-1">N° Comprobante / Op.</label>
                        <input type="text" id="abono-comprobante-input" placeholder="Ej: ABO-0123" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 font-medium focus:ring-2 focus:ring-cyan-500 focus:outline-none">
                    </div>
                </div>

                <div>
                    <label class="block font-bold text-slate-700 mb-1">Notas u Observaciones</label>
                    <input type="text" id="abono-notas-input" placeholder="Ej: Pago parcial acordado en tesorería" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 font-medium focus:ring-2 focus:ring-cyan-500 focus:outline-none">
                </div>

                <div class="pt-3 flex items-center justify-end space-x-3 border-t border-slate-100">
                    <button type="button" onclick="cerrarModalAbonar()" class="px-4 py-2 text-slate-600 hover:bg-slate-100 rounded-xl font-semibold transition">
                        Cancelar
                    </button>
                    <button type="submit" class="px-5 py-2.5 bg-cyan-600 hover:bg-cyan-700 text-white font-bold rounded-xl shadow-lg shadow-cyan-600/30 transition flex items-center space-x-2">
                        <i class="fa-solid fa-floppy-disk"></i>
                        <span>Confirmar Abono en Caja</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- ======================================================== -->
    <!-- MODAL 3: REGISTRAR NUEVO MOVIMIENTO GENERAL             -->
    <!-- ======================================================== -->
    <div id="modal-nuevo-movimiento" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
        <div class="bg-white w-full max-w-xl rounded-2xl shadow-2xl border border-slate-100 overflow-hidden transform transition-all max-h-[92vh] flex flex-col">
            <div class="p-5 bg-gradient-to-r from-slate-900 via-slate-800 to-sky-950 text-white flex items-center justify-between flex-shrink-0">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 rounded-xl bg-sky-500/20 border border-sky-400/30 flex items-center justify-center text-sky-400 text-lg">
                        <i class="fa-solid fa-cash-register"></i>
                    </div>
                    <div>
                        <h3 class="font-bold text-base">Registrar Movimiento en Caja</h3>
                        <p class="text-[11px] text-slate-300">Selecciona el tipo, grupo, encargado y digita la cantidad</p>
                    </div>
                </div>
                <button onclick="cerrarModalNuevoMovimiento()" class="text-slate-400 hover:text-white text-lg p-1">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <form id="form-nuevo-movimiento" onsubmit="guardarMovimiento(event)" class="p-6 space-y-4 text-xs overflow-y-auto custom-scrollbar flex-1">
                <!-- 1. TIPO DE MOVIMIENTO (SELECTOR VISUAL) -->
                <div>
                    <label class="block font-bold text-slate-700 mb-1.5 uppercase tracking-wider text-[11px]">
                        1. Tipo de Movimiento *
                    </label>
                    <div class="grid grid-cols-2 gap-3">
                        <button type="button" id="btn-tipo-ingreso" onclick="seleccionarTipoMovimiento('Ingreso')" class="py-3 px-4 rounded-xl border-2 border-emerald-500 bg-emerald-50 text-emerald-800 font-extrabold flex items-center justify-center space-x-2 transition shadow-sm">
                            <i class="fa-solid fa-circle-arrow-down text-emerald-600 text-base"></i>
                            <span class="text-xs">🟢 INGRESO (Entrada de Dinero)</span>
                        </button>
                        <button type="button" id="btn-tipo-egreso" onclick="seleccionarTipoMovimiento('Egreso')" class="py-3 px-4 rounded-xl border-2 border-slate-200 bg-slate-50 text-slate-600 font-bold flex items-center justify-center space-x-2 transition hover:bg-rose-50 hover:text-rose-700">
                            <i class="fa-solid fa-circle-arrow-up text-rose-500 text-base"></i>
                            <span class="text-xs">🔴 EGRESO (Salida / Gasto)</span>
                        </button>
                    </div>
                    <input type="hidden" id="form-tipo" value="Ingreso">
                </div>

                <!-- 2. SECCIÓN POR GRUPO Y ENCARGADO DE ESA CLASE -->
                <div class="bg-indigo-50/50 p-3.5 rounded-xl border border-indigo-100 space-y-3">
                    <div class="flex items-center space-x-2 text-indigo-900 font-bold text-[11px] uppercase tracking-wider">
                        <i class="fa-solid fa-users-rectangle text-indigo-600"></i>
                        <span>2. Sección por Grupo y Encargado de esa Clase</span>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                        <div>
                            <label class="block font-bold text-slate-700 mb-1">Grupo o Sección</label>
                            <select id="form-grupo" onchange="alCambiarGrupoEnModal()" class="w-full bg-white border border-slate-300 rounded-xl px-3 py-2 font-medium focus:ring-2 focus:ring-indigo-500 focus:outline-none text-xs">
                                <option value="General">General / Institucional</option>
                            </select>
                        </div>

                        <div>
                            <label class="block font-bold text-slate-700 mb-1">Docente / Encargado de la Clase</label>
                            <input type="text" id="form-encargado" placeholder="Ej: Ing. Carlos Mendoza Ruiz" class="w-full bg-white border border-slate-300 rounded-xl px-3 py-2 font-medium focus:ring-2 focus:ring-indigo-500 focus:outline-none text-xs">
                        </div>
                    </div>
                </div>

                <!-- 3. PERSONA, ROL Y ESPECIALIDAD -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                    <div>
                        <label class="block font-bold text-slate-700 mb-1">Rol de la Persona</label>
                        <select id="form-rol" required class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 font-medium focus:ring-2 focus:ring-sky-500 focus:outline-none">
                            <option value="Estudiante">Estudiante</option>
                            <option value="Docente">Docente / Profesor</option>
                            <option value="General">General / Institucional</option>
                        </select>
                    </div>

                    <div>
                        <label class="block font-bold text-slate-700 mb-1">Nombre Completo</label>
                        <input type="text" id="form-nombre" required placeholder="Ej: Fernando Quispe / Prof. Carlos" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 font-medium focus:ring-2 focus:ring-sky-500 focus:outline-none">
                    </div>

                    <div>
                        <label class="block font-bold text-slate-700 mb-1">Especialidad / Carrera</label>
                        <select id="form-carrera" required class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 font-medium focus:ring-2 focus:ring-sky-500 focus:outline-none">
                            <option value="Computación e Informática">Computación e Informática</option>
                            <option value="Confección Textil">Confección Textil</option>
                            <option value="Cosmetología y Peluquería">Cosmetología y Peluquería</option>
                            <option value="Gastronomía y Pastelería">Gastronomía y Pastelería</option>
                            <option value="Electricidad y Electrónica">Electricidad y Electrónica</option>
                            <option value="Contabilidad y Finanzas">Contabilidad y Finanzas</option>
                            <option value="General">General / Institucional</option>
                        </select>
                    </div>
                </div>

                <!-- 4. CONCEPTO Y NOTA -->
                <div>
                    <label class="block font-bold text-slate-700 mb-1">Concepto del Movimiento *</label>
                    <input type="text" id="form-concepto" required placeholder="Ej: Pensión Abril, Honorarios de Clase, Materiales de Taller..." class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 font-medium focus:ring-2 focus:ring-sky-500 focus:outline-none">
                </div>

                <!-- 5. INGRESAR LA CANTIDAD (DESTACADO CON BOTONES RÁPIDOS) -->
                <div class="bg-slate-50 p-4 rounded-2xl border-2 border-sky-300/80">
                    <div class="flex items-center justify-between mb-1.5">
                        <label class="block font-black text-slate-900 text-xs uppercase tracking-wider flex items-center">
                            <i class="fa-solid fa-coins text-amber-500 mr-1.5 text-sm"></i>
                            <span>Ingresar la Cantidad (S/.) *</span>
                        </label>
                        <span class="text-[10px] text-sky-700 font-bold">Digita o usa botones rápidos</span>
                    </div>

                    <div class="relative">
                        <span class="absolute left-3.5 top-2.5 text-lg font-black text-slate-400">S/.</span>
                        <input type="number" step="0.01" min="0.01" id="form-monto" required placeholder="0.00" class="w-full pl-12 pr-4 py-2.5 bg-white border-2 border-sky-400 focus:border-sky-600 rounded-xl font-black text-2xl text-slate-900 focus:ring-2 focus:ring-sky-500 focus:outline-none tracking-wide">
                    </div>

                    <!-- Botones de incremento rápido de cantidad -->
                    <div class="flex flex-wrap items-center gap-1.5 mt-2.5">
                        <span class="text-[10px] font-extrabold text-slate-400 uppercase mr-1">Rápido:</span>
                        <button type="button" onclick="setCantidadRapida(20, true)" class="px-2.5 py-1 bg-white hover:bg-sky-50 hover:text-sky-700 border border-slate-300 rounded-lg text-xs font-bold transition shadow-sm">+S/. 20</button>
                        <button type="button" onclick="setCantidadRapida(50, true)" class="px-2.5 py-1 bg-white hover:bg-sky-50 hover:text-sky-700 border border-slate-300 rounded-lg text-xs font-bold transition shadow-sm">+S/. 50</button>
                        <button type="button" onclick="setCantidadRapida(100, true)" class="px-2.5 py-1 bg-white hover:bg-sky-50 hover:text-sky-700 border border-slate-300 rounded-lg text-xs font-bold transition shadow-sm">+S/. 100</button>
                        <button type="button" onclick="setCantidadRapida(150, true)" class="px-2.5 py-1 bg-white hover:bg-sky-50 hover:text-sky-700 border border-slate-300 rounded-lg text-xs font-bold transition shadow-sm">+S/. 150</button>
                        <button type="button" onclick="setCantidadRapida(200, true)" class="px-2.5 py-1 bg-white hover:bg-sky-50 hover:text-sky-700 border border-slate-300 rounded-lg text-xs font-bold transition shadow-sm">+S/. 200</button>
                        <button type="button" onclick="setCantidadRapida(500, true)" class="px-2.5 py-1 bg-white hover:bg-sky-50 hover:text-sky-700 border border-slate-300 rounded-lg text-xs font-bold transition shadow-sm">+S/. 500</button>
                        <button type="button" onclick="setCantidadRapida(0, false)" class="px-2.5 py-1 bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 rounded-lg text-xs font-bold transition ml-auto">
                            <i class="fa-solid fa-eraser mr-1"></i>Limpiar
                        </button>
                    </div>
                </div>

                <!-- 6. NOTA U OBSERVACIÓN -->
                <div>
                    <label class="block font-bold text-slate-700 mb-1 flex items-center">
                        <i class="fa-regular fa-note-sticky text-amber-500 mr-1.5"></i>
                        <span>Nota u Observación del Movimiento</span>
                    </label>
                    <textarea id="form-notas" rows="2" placeholder="Ej: Materiales para práctica de taller, cuota acordada en reunión de sección, saldo de módulo..." class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 font-medium focus:ring-2 focus:ring-sky-500 focus:outline-none text-xs"></textarea>
                </div>

                <!-- 7. FECHA, MÉTODO Y ESTADO -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                    <div>
                        <label class="block font-bold text-slate-700 mb-1">Fecha</label>
                        <input type="date" id="form-fecha" required class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 font-medium focus:ring-2 focus:ring-sky-500 focus:outline-none">
                    </div>

                    <div>
                        <label class="block font-bold text-slate-700 mb-1">Método de Pago</label>
                        <select id="form-metodo" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 font-medium focus:ring-2 focus:ring-sky-500 focus:outline-none">
                            <option value="Efectivo">Efectivo</option>
                            <option value="Transferencia">Transferencia Bancaria</option>
                            <option value="Yape / Plin">Yape / Plin</option>
                            <option value="Tarjeta">Tarjeta de Débito/Crédito</option>
                            <option value="Cheque">Cheque</option>
                        </select>
                    </div>

                    <div>
                        <label class="block font-bold text-slate-700 mb-1">Estado</label>
                        <select id="form-estado" onchange="toggleFechaVencimiento()" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 font-medium focus:ring-2 focus:ring-sky-500 focus:outline-none">
                            <option value="Pagado">Pagado / Cobrado</option>
                            <option value="Pendiente">Pendiente (Por cobrar/pagar)</option>
                        </select>
                    </div>
                </div>

                <div id="div-vencimiento" class="hidden bg-amber-50 p-3 rounded-xl border border-amber-200">
                    <label class="block font-bold text-amber-900 mb-1">Fecha de Vencimiento del Periodo</label>
                    <input type="date" id="form-vencimiento" class="w-full bg-white border border-amber-300 rounded-xl px-3 py-2 text-xs font-medium focus:ring-2 focus:ring-amber-500 focus:outline-none">
                    <p class="text-[10px] text-amber-700 mt-1">Se emitirá alerta antes de que expire esta fecha en el módulo de deudores.</p>
                </div>

                <div class="pt-3 flex items-center justify-end space-x-3 border-t border-slate-100 flex-shrink-0">
                    <button type="button" onclick="cerrarModalNuevoMovimiento()" class="px-4 py-2 text-slate-600 hover:bg-slate-100 rounded-xl font-semibold transition">
                        Cancelar
                    </button>
                    <button type="submit" class="px-6 py-2.5 bg-gradient-to-r from-sky-600 to-blue-600 hover:from-sky-500 hover:to-blue-500 text-white font-bold rounded-xl shadow-lg shadow-sky-600/30 transition flex items-center space-x-2">
                        <i class="fa-solid fa-floppy-disk"></i>
                        <span>Guardar Movimiento y Cantidad</span>
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- ======================================================== -->
    <!-- MODAL 3.1: CREAR NUEVA SECCIÓN / GRUPO                   -->
    <!-- ======================================================== -->
    <div id="modal-nuevo-grupo" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-50 flex items-center justify-center hidden p-4">
        <div class="bg-white w-full max-w-lg rounded-2xl shadow-2xl border border-slate-100 overflow-hidden transform transition-all">
            <div class="p-5 bg-gradient-to-r from-indigo-900 to-slate-900 text-white flex items-center justify-between">
                <div class="flex items-center space-x-2.5">
                    <div class="w-10 h-10 rounded-xl bg-indigo-500/20 border border-indigo-400/30 flex items-center justify-center text-indigo-400 text-lg">
                        <i class="fa-solid fa-users-rectangle"></i>
                    </div>
                    <div>
                        <h3 class="font-bold text-base">Crear Nueva Sección / Grupo</h3>
                        <p class="text-[11px] text-indigo-200">Asigna la clase, turno y el docente/encargado responsable</p>
                    </div>
                </div>
                <button onclick="cerrarModalNuevoGrupo()" class="text-slate-400 hover:text-white text-lg p-1">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <form id="form-nuevo-grupo" onsubmit="guardarNuevoGrupo(event)" class="p-6 space-y-4 text-xs">
                <div>
                    <label class="block font-bold text-slate-700 mb-1">Nombre de la Sección / Grupo *</label>
                    <input type="text" id="nuevo-grupo-nombre" required placeholder="Ej: Confección Textil - Grupo B" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 font-medium focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block font-bold text-slate-700 mb-1">Especialidad / Carrera *</label>
                        <select id="nuevo-grupo-carrera" required class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 font-medium focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                            <option value="Computación e Informática">Computación e Informática</option>
                            <option value="Confección Textil">Confección Textil</option>
                            <option value="Cosmetología y Peluquería">Cosmetología y Peluquería</option>
                            <option value="Gastronomía y Pastelería">Gastronomía y Pastelería</option>
                            <option value="Electricidad y Electrónica">Electricidad y Electrónica</option>
                            <option value="Contabilidad y Finanzas">Contabilidad y Finanzas</option>
                        </select>
                    </div>

                    <div>
                        <label class="block font-bold text-slate-700 mb-1">Turno *</label>
                        <select id="nuevo-grupo-turno" required class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 font-medium focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                            <option value="Mañana">Turno Mañana</option>
                            <option value="Tarde">Turno Tarde</option>
                            <option value="Noche">Turno Noche</option>
                        </select>
                    </div>
                </div>

                <div>
                    <label class="block font-bold text-slate-700 mb-1">Docente / Encargado de esa Clase *</label>
                    <input type="text" id="nuevo-grupo-encargado" required placeholder="Ej: Prof. Rosa Quispe Huamán" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 font-medium focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block font-bold text-slate-700 mb-1">Horario de Clases</label>
                        <input type="text" id="nuevo-grupo-horario" placeholder="Ej: Lun - Vie 08:00 - 13:00" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 font-medium focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                    </div>

                    <div>
                        <label class="block font-bold text-slate-700 mb-1">Aula / Taller Asignado</label>
                        <input type="text" id="nuevo-grupo-aula" placeholder="Ej: Taller Textil N° 1" class="w-full bg-slate-50 border border-slate-300 rounded-xl px-3 py-2 font-medium focus:ring-2 focus:ring-indigo-500 focus:outline-none">
                    </div>

            <!-- 2.5 SECCIÓN: SECCIONES POR GRUPO Y ENCARGADO DE CLASE              -->
            <!-- =================================================================== -->
            <div id="section-grupos" class="hidden space-y-6">
                <!-- Banner Superior -->
                <div class="bg-gradient-to-r from-indigo-900 via-slate-900 to-sky-950 p-6 rounded-2xl text-white shadow-xl flex flex-wrap items-center justify-between gap-4">
                    <div class="flex items-center space-x-4">
                        <div class="w-12 h-12 rounded-2xl bg-indigo-500/20 border border-indigo-400/40 text-indigo-400 flex items-center justify-center text-2xl shadow-lg">
                            <i class="fa-solid fa-users-rectangle"></i>
                        </div>
                        <div>
                            <div class="flex items-center space-x-2 text-indigo-300 text-xs font-bold uppercase tracking-wider mb-1">
                                <i class="fa-solid fa-chalkboard-user"></i>
                                <span>Organización Académica • CETPRO San Miguel</span>
                            </div>
                            <h3 class="text-xl font-bold">Secciones por Grupo y Encargado de Clase</h3>
                            <p class="text-xs text-slate-300 mt-1">Supervisión integral de grupos, docentes/encargados a cargo de cada aula, alumnos inscritos y control de cantidades y movimientos monetarios.</p>
                        </div>
                    </div>

                    <div class="flex items-center space-x-3">
                        <button onclick="abrirModalNuevoGrupo()" class="bg-gradient-to-r from-indigo-500 to-purple-600 hover:from-indigo-400 hover:to-purple-500 text-white font-bold px-4 py-2.5 rounded-xl text-xs flex items-center space-x-2 shadow-lg shadow-indigo-500/30 transition">
                            <i class="fa-solid fa-plus-circle"></i>
                            <span>Crear Nueva Sección / Grupo</span>
                        </button>
                        <button onclick="abrirModalNuevoMovimiento()" class="bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-400 hover:to-teal-500 text-white font-bold px-4 py-2.5 rounded-xl text-xs flex items-center space-x-2 shadow-lg shadow-emerald-500/30 transition">
                            <i class="fa-solid fa-money-bill-wave"></i>
                            <span>Ingresar Cantidad / Movimiento</span>
                        </button>
                    </div>
                </div>

                <!-- Métricas Rápidas de Grupos -->
